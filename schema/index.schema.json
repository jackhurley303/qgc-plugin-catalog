{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackhurley303.github.io/qgc-plugin-catalog/schema/index.schema.json",
  "title": "QGroundControl plugin catalog index, schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generated", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "entry.schema.json" }
    }
  }
}
