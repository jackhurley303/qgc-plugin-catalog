{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackhurley303.github.io/qgc-plugin-catalog/schema/entry.schema.json",
  "title": "QGroundControl plugin catalog entry, schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "summary", "description", "license", "versions"],
  "anyOf": [{ "required": ["repository"] }, { "required": ["releaseRepository"] }],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
      "not": { "pattern": "\\.git$" }
    },
    "releaseRepository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
      "not": { "pattern": "\\.git$" }
    },
    "icon": { "type": "string", "pattern": "^https://" },
    "screenshots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https://" }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" }
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tier", "hostVersion", "released", "packages"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "tier": { "enum": ["qml", "sdk"] },
        "apiVersion": { "type": "integer", "minimum": 1 },
        "qmlApiVersion": { "type": "integer", "minimum": 1 },
        "hostVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min"],
          "properties": {
            "min": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
            "max": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)*)?$" }
          }
        },
        "released": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string" },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["macos-universal", "windows-x64", "linux-x64", "any"] },
          "additionalProperties": { "$ref": "#/$defs/package" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "tier": { "const": "sdk" } } },
          "then": {
            "required": ["apiVersion"],
            "properties": {
              "packages": { "propertyNames": { "not": { "const": "any" } } }
            }
          }
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
