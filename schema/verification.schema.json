{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jackhurley303.github.io/qgc-plugin-catalog/schema/verification.schema.json",
  "title": "QGroundControl plugin catalog verification record, schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "packages", "sourceCommit", "method", "reviewer", "date"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["macos-universal", "windows-x64", "linux-x64", "any"] },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "method": { "enum": ["maintainer-build", "attestation"] },
        "reviewer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$" },
        "date": { "$ref": "#/$defs/date" },
        "revoked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "reason"],
          "properties": {
            "date": { "$ref": "#/$defs/date" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
